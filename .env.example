# Set explicitly in the process environment; .env files are not auto-loaded.
# Local development/test database only. Never point a migration at production by accident.
# Configured servers apply embedded migrations before HTTP and the in-process worker start.
FEDKR_DATABASE_URL=postgresql://fedkr_dev@127.0.0.1:16439/fedkr_dev
FEDKR_PUBLIC_ORIGIN=http://127.0.0.1:12239
# Optional additional PEM CA bundle for PostgreSQL only (absolute regular file,
# nonempty, at most 256 KiB, certificates only). No hostname verification bypass.
# Setting this forces TLS even for loopback; omit for the plaintext dev PG above.
# FEDKR_DATABASE_CA_FILE=/run/fedkr/db-ca.pem
# Optional private file store, using the objects/<sha256> bundle layout.
# FEDKR_MEDIA_DIR must be an existing absolute private directory (not public assets).
# Copy/mount the verified bundle here for deployment; see docs/porting/legacy-assets.md.
# The live copy needs read/write/delete permissions for logo uploads and media cleanup.
# All runtime writers use the same local Fs lock; do not replace .runtime.lock.
# Preserve a separate original export/backup before activation; never mount it as the live store.
# HTTPS is mandatory except for loopback development. Never use forwarded Host as authority.

# Integration tests accept only the isolated loopback:16439/fedkr_test database.
# FEDKR_TEST_DATABASE_URL=postgresql://fedkr_dev@127.0.0.1:16439/fedkr_test

# Offline import only: see docs/porting/legacy-import.md. Do not put real values here.
# FEDKR_IMPORT_SOURCE_URL must name an isolated loopback fedkr_snapshot_* database.
# FEDKR_IMPORT_TARGET_URL must name an empty loopback fedkr_rehearsal_* database.
# Offline file preservation after import: docs/porting/legacy-assets.md.
# FEDKR_ASSET_SOURCE_DIR is the existing absolute private storage export root.
# FEDKR_ASSET_BUNDLE_DIR is a separate existing absolute private bundle root.
# Do not place either directory in the public web assets tree.

# Reviewed-copy activation only: docs/porting/activation.md. Does not switch traffic.
# FEDKR_ACTIVATION_TARGET_URL names a separately renamed private loopback fedkr_live_* copy.
# --legacy-activate checks only; --apply additionally requires an operator acknowledgment.
# FEDKR_ACTIVATION_ACK must be supplied deliberately as source-frozen-and-reviewed, not preset here.
# Reuse FEDKR_IMPORT_SOURCE_URL, FEDKR_PUBLIC_ORIGIN and the two FEDKR_ASSET_*_DIR roots above.
